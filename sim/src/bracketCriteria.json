{
  "source": "Commander Brackets (Wizards of the Coast, beta of February 2025, as revised April 2025). Criteria live here as data because WotC revises them; the code only counts.",
  "brackets": [
    { "id": 1, "name": "Exhibition", "gameChangers": 0, "massLandDenial": false, "extraTurnCards": 1, "tutors": 3 },
    { "id": 2, "name": "Core", "gameChangers": 0, "massLandDenial": false, "extraTurnCards": 1, "tutors": 3 },
    { "id": 3, "name": "Upgraded", "gameChangers": 3, "massLandDenial": false, "extraTurnCards": 1, "tutors": null },
    { "id": 4, "name": "Optimized", "gameChangers": null, "massLandDenial": true, "extraTurnCards": null, "tutors": null },
    { "id": 5, "name": "cEDH", "gameChangers": null, "massLandDenial": true, "extraTurnCards": null, "tutors": null }
  ],
  "lowest": 2,
  "detect": {
    "massLandDenial": {
      "patterns": [
        "destroy all (?:[a-z]+, )*(?:and )?(?:nonbasic )?lands\\b",
        "exile all (?:[a-z]+, )*(?:and )?(?:nonbasic )?lands\\b",
        "each player sacrifices (?:all|two|three|four|five|six|seven|x|\\d+) [^.]*\\blands\\b",
        "each player sacrifices [^.]*\\blands? (?:they control )?for each\\b",
        "return all (?:permanents|lands) to their owners' hands",
        "\\blands don't untap during their controllers' untap steps",
        "nonbasic lands don't untap",
        "nonbasic lands are mountains",
        "players skip their untap steps",
        "players can't untap more than (?:one|two|three|\\d+) (?:lands?|permanents?)\\b"
      ],
      "exclude": ["\\btarget player\\b", "\\bexcept for\\b", "\\bof that type\\b", "\\bup to\\b", "\\bin the chosen piles\\b"],
      "names": ["Cataclysm", "Catastrophe", "Decree of Annihilation", "Keldon Firebombers", "Desolation Angel", "Rising Waters", "Hokori, Dust Drinker", "Mana Vortex", "Tectonic Break", "Fall of the Thran", "Boom // Bust", "Natural Balance", "Thoughts of Ruin", "Global Ruin", "Price of Glory", "Bend or Break", "Myojin of Infinite Rage", "Impending Disaster"],
      "ignore": ["Winter Moon", "Elspeth Tirel", "World-Bottling Kit", "Scourglass"]
    },
    "extraTurns": {
      "patterns": ["\\btakes? an extra turn\\b", "\\btakes? (?:two|three|four|\\d+) extra turns?\\b"],
      "exclude": ["\\bopponent\\b", "\\beach player\\b"]
    }
  }
}
